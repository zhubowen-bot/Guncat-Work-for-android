{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "noEmit": true,
    "strict": false,
    "strictNullChecks": false,
    "strictFunctionTypes": false,
    "useUnknownInCatchVariables": false,
    "noImplicitAny": true,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@main/*": ["src/main/*"],
      "@ipc/*": ["src/ipc/*"],
      "@renderer/*": ["src/renderer/src/*"],
      "@kit.ArkTS": ["src/mobile/kit/ArkTS.ts"],
      "@kit.CoreFileKit": ["src/core/platform/kit/CoreFileKit.ts"],
      "@kit.NetworkKit": ["src/core/platform/kit/NetworkKit.ts"],
      "@kit.BasicServicesKit": ["src/core/platform/kit/BasicServicesKit.ts"],
      "@kit.AbilityKit": ["src/core/platform/kit/AbilityKit.ts"],
      "@kit.ArkData": ["src/core/platform/kit/ArkData.ts"],
      "@kit.PerformanceAnalysisKit": ["src/core/platform/kit/PerformanceAnalysisKit.ts"],
      "@kit.ImageKit": ["src/mobile/kit/ImageKit.ts"],
      "@kit.PDFKit": ["src/mobile/kit/PDFKit.ts"],
      "libguncatjs.so": ["src/mobile/platform/libguncatjs.ts"],
      "@core/platform/shellExec": ["src/mobile/platform/shellExec.ts"],
      "@core/platform/native/svgRaster": ["src/mobile/platform/svgRaster.ts"]
    },
    "outDir": "./out/types-mobile"
  },
  "include": [
    "src/mobile/**/*.ts",
    "src/mobile/**/*.tsx",
    "src/renderer/src/**/*.ts",
    "src/renderer/src/**/*.tsx",
    "src/core/platform/kit/globals.d.ts",
    "src/main/session/**/*.ts",
    "src/main/asr.ts",
    "src/main/sanitizeHtml.ts",
    "src/ipc/**/*.ts",
    "vite.mobile.config.ts"
  ]
}
