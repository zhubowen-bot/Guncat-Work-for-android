<!--
  安装向导的四个页面。全部预先建好、靠 Visibility 切换 —— 页面之间没有转场动画，
  换成动态替换 Content 只会多一份视觉状态要维护，不划算。

  命名元素在 setup.cs 里 FindName 后挂事件（XamlReader 不支持事件属性）。
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="{StaticResource UiFont}">

  <!-- ================= 页面 1：选项 ================= -->
  <Grid x:Name="PageOptions">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="安装 Guncat Work" Style="{StaticResource T_Title}"/>
    <TextBlock Grid.Row="1" Text="选择安装位置与安装选项，然后点击「开始安装」。"
               Style="{StaticResource T_Sub}" Margin="0,8,0,0"/>

    <StackPanel Grid.Row="2" Margin="0,22,0,0">
      <TextBlock Text="安装位置" Style="{StaticResource T_Section}"/>
      <Grid Margin="0,9,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="TxtDir" Style="{StaticResource FieldModern}"/>
        <Button x:Name="BtnBrowse" Grid.Column="1" Content="浏览…" Style="{StaticResource LinkButton}"
                Margin="8,0,0,0" Height="34"/>
      </Grid>
      <TextBlock x:Name="TxtSpace" Style="{StaticResource T_Muted}" Margin="0,7,0,0"
                 Text="需要 0 MB"/>
      <TextBlock x:Name="TxtWarn" Margin="0,5,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                 FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="#FFE8574A"
                 Text="这个位置当前写不进去。"/>

      <Border Height="1" Background="{StaticResource StrokeSoft}" Margin="0,18,0,16"/>

      <TextBlock Text="安装选项" Style="{StaticResource T_Section}"/>
      <StackPanel Margin="0,12,0,0">
        <CheckBox x:Name="ChkDesktop" Style="{StaticResource CheckModern}" IsChecked="True"
                  Content="创建桌面快捷方式"/>
        <CheckBox x:Name="ChkStartMenu" Style="{StaticResource CheckModern}" IsChecked="True"
                  Margin="0,11,0,0" Content="创建开始菜单快捷方式"/>
        <CheckBox x:Name="ChkLaunch" Style="{StaticResource CheckModern}" IsChecked="True"
                  Margin="0,11,0,0" Content="安装完成后立即启动 Guncat Work"/>
        <CheckBox x:Name="ChkAdmin" Style="{StaticResource CheckModern}" Margin="0,11,0,0"
                  Content="兼容模式：始终以管理员身份运行"/>
        <TextBlock x:Name="TxtAdminHint" Style="{StaticResource T_Muted}" Margin="28,4,0,0"
                   TextWrapping="Wrap"
                   Text="勾选后会给 exe 挂上 RUNASADMIN 兼容层，每次启动弹一次 UAC。只有在双击没反应时才需要。"/>
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}"/>
      <Button x:Name="BtnInstall" Content="开始安装" Style="{StaticResource AccentButton}" Margin="10,0,0,0"/>
    </StackPanel>
  </Grid>

  <!-- ================= 页面 2：进度 ================= -->
  <Grid x:Name="PageProgress" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="正在安装" Style="{StaticResource T_Title}"/>
    <TextBlock Grid.Row="1" x:Name="TxtStep" Text="准备中…" Style="{StaticResource T_Sub}"
               Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

    <Border Grid.Row="2" VerticalAlignment="Top" Margin="0,26,0,0" CornerRadius="14"
            Background="#FF121A25" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
            Padding="22,20,22,22">
      <StackPanel>
        <TextBlock x:Name="TxtStage" Text="正在解压文件" Style="{StaticResource T_Body}"/>
        <ProgressBar x:Name="BarProgress" Style="{StaticResource ProgressModern}" Margin="0,16,0,0"
                     Minimum="0" Maximum="100" Value="0"/>
        <Grid Margin="0,12,0,0">
          <TextBlock x:Name="TxtPercent" Text="0%" HorizontalAlignment="Left"
                     FontFamily="{StaticResource UiFont}" FontSize="20" FontWeight="SemiBold"
                     Foreground="{StaticResource TextPrimary}"/>
          <TextBlock x:Name="TxtSpeed" Text="" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Style="{StaticResource T_Sub}"/>
        </Grid>
        <TextBlock x:Name="TxtDetail" Text="" Style="{StaticResource T_Muted}" Margin="0,10,0,0"
                   TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BtnAbort" Content="取消" Style="{StaticResource GhostButton}"/>
    </StackPanel>
  </Grid>

  <!-- ================= 页面 3：完成 ================= -->
  <Grid x:Name="PageDone" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" VerticalAlignment="Center">
      <Grid Width="70" Height="70" HorizontalAlignment="Left">
        <Ellipse>
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF35D08A" Offset="0"/>
              <GradientStop Color="#FF22B8A6" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="#FF35D08A"/>
          </Ellipse.Effect>
        </Ellipse>
        <Path Data="M 0,8 L 9,17 L 24,1" Stroke="#FFFFFFFF" StrokeThickness="3.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>

      <TextBlock Text="安装完成" Style="{StaticResource T_Title}" Margin="0,22,0,0"/>
      <TextBlock x:Name="TxtDoneWhere" Style="{StaticResource T_Sub}" Margin="0,9,0,0"
                 TextWrapping="Wrap" Text="Guncat Work 已安装到你的电脑。"/>
      <TextBlock Style="{StaticResource T_Muted}" Margin="0,16,0,0" TextWrapping="Wrap"
                 Text="首次启动后，打开左下角「设置」填入接入方式、Base URL、API Key 与模型，即可开始对话。"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BtnUninstallTip" Content="查看安装目录" Style="{StaticResource GhostButton}"/>
      <Button x:Name="BtnLaunch" Content="启动 Guncat Work" Style="{StaticResource AccentButton}"
              Margin="10,0,0,0"/>
    </StackPanel>
  </Grid>

  <!-- ================= 页面 4：出错 ================= -->
  <Grid x:Name="PageError" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" VerticalAlignment="Center">
      <Grid Width="60" Height="60" HorizontalAlignment="Left">
        <Ellipse Fill="#FF3A2028"/>
        <Path Data="M 0,0 L 0,14 M 0,20 L 0,21" Stroke="{StaticResource DangerSolid}" StrokeThickness="3.4"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="安装未完成" Style="{StaticResource T_Title}" Margin="0,20,0,0"/>
      <TextBlock x:Name="TxtError" Style="{StaticResource T_Body}" Margin="0,10,0,0"
                 TextWrapping="Wrap"/>
      <TextBlock Style="{StaticResource T_Muted}" Margin="0,12,0,0" TextWrapping="Wrap"
                 Text="点「重试」可以回去换一个安装位置；装到别处不影响使用。"/>
      <TextBlock x:Name="TxtErrorLog" Style="{StaticResource T_Muted}" Margin="0,8,0,0"
                 TextWrapping="Wrap"/>
    </StackPanel>

    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="BtnErrorClose" Content="关闭" Style="{StaticResource GhostButton}"/>
      <Button x:Name="BtnRetry" Content="重试" Style="{StaticResource AccentButton}" Margin="10,0,0,0"/>
    </StackPanel>
  </Grid>

</Grid>
