<!--
  卸载程序的界面。比安装程序少两页：确认 → 进度 → 结果（出错时切到错误页）。

  这里是独立编译出的小 exe（不共用安装程序的 exe），因为它要留在安装目录里、
  在被卸载时删除自己所在的那棵树。
-->
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="{StaticResource UiFont}">

  <!-- ================= 确认 ================= -->
  <Grid x:Name="PageConfirm">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="卸载 Guncat Work" Style="{StaticResource T_Title}"/>
    <TextBlock Grid.Row="1" Text="这会删除应用文件、快捷方式，以及「应用和功能」里的登记项。"
               Style="{StaticResource T_Sub}" Margin="0,8,0,0" TextWrapping="Wrap"/>

    <StackPanel Grid.Row="2" Margin="0,20,0,0">
      <TextBlock Text="将要删除" Style="{StaticResource T_Section}"/>
      <Border CornerRadius="10" Background="#FF121A25" BorderBrush="{StaticResource StrokeSoft}"
              BorderThickness="1" Padding="14,12" Margin="0,9,0,0">
        <TextBlock x:Name="TxtTarget" Style="{StaticResource T_Mono}" TextWrapping="Wrap"
                   Text="—"/>
      </Border>

      <CheckBox x:Name="ChkData" Style="{StaticResource CheckModern}" Margin="0,16,0,0"
                Content="同时删除我的数据与配置"/>
      <TextBlock x:Name="TxtDataHint" Style="{StaticResource T_Muted}" Margin="28,4,0,0"
                 TextWrapping="Wrap" Text="包含对话历史、沙箱工作区与 API 配置。"/>
    </StackPanel>

    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnCancel" Content="取消" Style="{StaticResource GhostButton}"/>
      <Button x:Name="BtnRemove" Content="卸载" Style="{StaticResource AccentButton}" Margin="10,0,0,0"/>
    </StackPanel>
  </Grid>

  <!-- ================= 进度 ================= -->
  <Grid x:Name="PageProgress" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Text="正在卸载" Style="{StaticResource T_Title}"/>
    <TextBlock Grid.Row="1" x:Name="TxtStep" Text="准备中…" Style="{StaticResource T_Sub}"
               Margin="0,8,0,0" TextWrapping="Wrap"/>

    <Border Grid.Row="2" VerticalAlignment="Top" Margin="0,22,0,0" CornerRadius="14"
            Background="#FF121A25" BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
            Padding="20,18,20,20">
      <StackPanel>
        <TextBlock x:Name="TxtStage" Text="正在删除文件" Style="{StaticResource T_Body}"/>
        <ProgressBar x:Name="BarProgress" Style="{StaticResource ProgressModern}" Margin="0,14,0,0"
                     Minimum="0" Maximum="100" Value="0"/>
        <TextBlock x:Name="TxtPercent" Text="0%" Margin="0,10,0,0"
                   FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimary}"/>
      </StackPanel>
    </Border>
  </Grid>

  <!-- ================= 完成 ================= -->
  <Grid x:Name="PageDone" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" VerticalAlignment="Center">
      <Grid Width="62" Height="62" HorizontalAlignment="Left">
        <Ellipse>
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
              <GradientStop Color="#FF35D08A" Offset="0"/>
              <GradientStop Color="#FF22B8A6" Offset="1"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <Path Data="M 0,7 L 8,15 L 21,1" Stroke="#FFFFFFFF" StrokeThickness="3.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="卸载完成" Style="{StaticResource T_Title}" Margin="0,20,0,0"/>
      <TextBlock x:Name="TxtDone" Style="{StaticResource T_Sub}" Margin="0,9,0,0" TextWrapping="Wrap"
                 Text="Guncat Work 已从这台电脑上移除。"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnDone" Content="关闭" Style="{StaticResource AccentButton}"/>
    </StackPanel>
  </Grid>

  <!-- ================= 出错 ================= -->
  <Grid x:Name="PageError" Visibility="Collapsed">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" VerticalAlignment="Center">
      <Grid Width="54" Height="54" HorizontalAlignment="Left">
        <Ellipse Fill="#FF3A2028"/>
        <Path Data="M 0,0 L 0,12 M 0,18 L 0,19" Stroke="{StaticResource DangerSolid}" StrokeThickness="3.2"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
              HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
      <TextBlock Text="卸载未完成" Style="{StaticResource T_Title}" Margin="0,18,0,0"/>
      <TextBlock x:Name="TxtError" Style="{StaticResource T_Body}" Margin="0,10,0,0" TextWrapping="Wrap"/>
      <TextBlock x:Name="TxtErrorLog" Style="{StaticResource T_Muted}" Margin="0,12,0,0"
                 TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
      <Button x:Name="BtnErrorClose" Content="关闭" Style="{StaticResource AccentButton}"/>
    </StackPanel>
  </Grid>

</Grid>
