<!--
  安装程序的视觉基础：颜色、字体、控件模板。

  为什么用 XAML 而不是在 C# 里手写控件树：
  WPF 的观感（圆角、渐变、阴影、悬停态）几乎全部来自 ControlTemplate，
  在 C# 里逐条 new 出来既长又难改。这里的 XAML 在运行时由 XamlReader 解析
  （见 common.cs 的 Res.LoadXaml），所以**不需要** XAML 编译器，
  代价是不能写 x:Class 与事件处理器 —— 命名元素一律在 C# 里 FindName 后挂事件。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===== 字体 ===== -->
  <FontFamily x:Key="UiFont">Microsoft YaHei UI, Microsoft YaHei, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

  <!-- ===== 颜色 ===== -->
  <SolidColorBrush x:Key="TextPrimary" Color="#FFEDF1F8"/>
  <SolidColorBrush x:Key="TextBody" Color="#FFC3CEDF"/>
  <SolidColorBrush x:Key="TextSecondary" Color="#FF8896AD"/>
  <SolidColorBrush x:Key="TextMuted" Color="#FF5B6880"/>
  <SolidColorBrush x:Key="StrokeSoft" Color="#FF27313F"/>
  <SolidColorBrush x:Key="StrokeStrong" Color="#FF39465C"/>
  <SolidColorBrush x:Key="AccentSolid" Color="#FF6C8DFF"/>
  <SolidColorBrush x:Key="SuccessSolid" Color="#FF35D08A"/>
  <SolidColorBrush x:Key="DangerSolid" Color="#FFE8574A"/>
  <SolidColorBrush x:Key="FieldBg" Color="#FF0F1620"/>

  <!-- 主色渐变：蓝 → 紫，用在主按钮、进度条、勾选框上 -->
  <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF4F86FF" Offset="0"/>
    <GradientStop Color="#FF9B6BFF" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="AccentBrushHover" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF6C9CFF" Offset="0"/>
    <GradientStop Color="#FFAE84FF" Offset="1"/>
  </LinearGradientBrush>
  <!-- 进度条：横向蓝→紫→青，视觉上更像「在跑」 -->
  <LinearGradientBrush x:Key="ProgressBrush" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#FF3E7BFF" Offset="0"/>
    <GradientStop Color="#FF8A6BFF" Offset="0.55"/>
    <GradientStop Color="#FF35D0C8" Offset="1"/>
  </LinearGradientBrush>

  <!-- 窗口底板 -->
  <LinearGradientBrush x:Key="WindowBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF161E2B" Offset="0"/>
    <GradientStop Color="#FF0D131C" Offset="1"/>
  </LinearGradientBrush>
  <!-- 左侧品牌栏 -->
  <LinearGradientBrush x:Key="BrandPanelBrush" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FF1D2839" Offset="0"/>
    <GradientStop Color="#FF111926" Offset="1"/>
  </LinearGradientBrush>

  <!-- ===== 文本样式 ===== -->
  <Style x:Key="T_Brand" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="25"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="T_Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="21"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
  </Style>
  <Style x:Key="T_Section" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
  </Style>
  <Style x:Key="T_Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
  </Style>
  <Style x:Key="T_Sub" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
  </Style>
  <Style x:Key="T_Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
  </Style>
  <Style x:Key="T_Muted" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
  </Style>

  <!-- ===== 主按钮 ===== -->
  <Style x:Key="AccentButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="#FFFFFFFF"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinWidth" Value="118"/>
    <Setter Property="Padding" Value="22,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" CornerRadius="10" Background="{StaticResource AccentBrush}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="content" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="{StaticResource AccentBrushHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="bg" Property="Background" Value="#FF2A3444"/>
              <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 次要按钮（描边） ===== -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="Padding" Value="20,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" CornerRadius="10" Background="#FF161E29"
                  BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="#FF1E2836"/>
              <Setter TargetName="bg" Property="BorderBrush" Value="#FF4A5B76"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="bg" Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 无边框小按钮（「浏览…」、标题栏） ===== -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource AccentSolid}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="12,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" CornerRadius="8" Background="#FF182131"
                  BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="{TemplateBinding Padding}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="#FF1F2B3D"/>
              <Setter TargetName="bg" Property="BorderBrush" Value="#FF4A5B76"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 标题栏按钮 ===== -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Width" Value="46"/>
    <Setter Property="Height" Value="44"/>
    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="#18FFFFFF"/>
              <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bg" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="Background" Value="#FFE81123"/>
              <Setter Property="Foreground" Value="#FFFFFFFF"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 勾选框 ===== -->
  <Style x:Key="CheckModern" TargetType="CheckBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextBody}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.4"
                    BorderBrush="{StaticResource StrokeStrong}" Background="{StaticResource FieldBg}"
                    VerticalAlignment="Center" SnapsToDevicePixels="True">
              <Path x:Name="tick" Data="M 0,4.2 L 3.4,7.6 L 9.6,1" Stroke="#FFFFFFFF" StrokeThickness="1.9"
                    StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentSolid}"/>
              <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="tick" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentSolid}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 输入框 ===== -->
  <Style x:Key="FieldModern" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
    <Setter Property="CaretBrush" Value="{StaticResource AccentSolid}"/>
    <Setter Property="SelectionBrush" Value="#FF3B5FA8"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Padding" Value="11,0"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bg" CornerRadius="8" Background="{StaticResource FieldBg}"
                  BorderBrush="{StaticResource StrokeStrong}" BorderThickness="1" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                          VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="{StaticResource AccentSolid}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="bg" Property="BorderBrush" Value="#FF4A5B76"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 进度条 ===== -->
  <Style x:Key="ProgressModern" TargetType="ProgressBar">
    <Setter Property="Height" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid SnapsToDevicePixels="True">
            <Border x:Name="PART_Track" CornerRadius="5" Background="#FF1B2431"/>
            <Border x:Name="PART_Indicator" CornerRadius="5" HorizontalAlignment="Left"
                    Background="{StaticResource ProgressBrush}"/>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== 小标签（版本号之类） ===== -->
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="#1FFFFFFF"/>
    <Setter Property="BorderBrush" Value="#26FFFFFF"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,3"/>
  </Style>

</ResourceDictionary>
